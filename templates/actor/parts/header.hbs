{{!-- header.hbs — 角色卡顶部三列区域（按规格重写） --}}
<header class="sheet-header">

  {{!-- ── 左列：头像 / LV / XP / HP / 理智 ────────────────────────── --}}
  <div class="header-col header-left">

    {{!-- A：头像区域（260px × 100px）：头像100×100 + XP区域150×60 --}}
    <div class="avatar-block">

      {{!-- 头像图片包裹层（100×100），锁图标叠在右上角 --}}
      <div class="avatar-img-wrap">
        {{#if isEditable}}
          <button class="sheet-lock-toggle locked" title="编辑锁">
            <i class="fas fa-lock"></i>
          </button>
          <img class="actor-avatar" src="{{actor.img}}" data-edit="img" title="更换头像" alt="avatar">
        {{else}}
          <img class="actor-avatar" src="{{actor.img}}" alt="avatar">
        {{/if}}
      </div>

      {{!-- XP 区域（150px × 60px），底部对齐 --}}
      <div class="xp-section">
        <div class="lv-row">
          <span class="lv-label">LV</span>
          {{#if isEditable}}
            <input type="number" name="system.level" value="{{system.level}}"
                   class="lv-value editable-field" min="1" max="50" disabled/>
          {{else}}
            <span class="lv-value">{{system.level}}</span>
          {{/if}}
          {{#if canLevelUp}}
            <button type="button" class="level-up-btn" title="升级">↑</button>
          {{/if}}
        </div>
        <div class="xp-values-row">
          {{#if isEditable}}
            <input type="number" name="system.xp.value" value="{{system.xp.value}}"
                   class="xp-current editable-field" min="0" disabled/>
          {{else}}
            <span class="xp-current">{{system.xp.value}}</span>
          {{/if}}
          <span class="xp-sep"> / </span>
          <span class="xp-max">{{system.xp.next}}</span>
        </div>
        <div class="xp-bar-wrap">
          <div class="xp-bar-fill" style="width:{{clamp xpPercent 0 100}}%"></div>
        </div>
      </div>

    </div>{{!-- /avatar-block --}}

    {{!-- B：HP 行（图标32px + 血条200×32 + 重置20px） --}}
    <div class="resource-row hp-row">
      <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/Health.webp" class="resource-icon" alt="HP">
      <div class="resource-bar-wrap">
        <div class="resource-bar hp-bar">
          <div class="resource-bar-fill hp-fill" style="width:{{clamp hpPercent 0 100}}%"></div>
          {{!-- 护盾条：叠加在 HP 末端，青色 --}}
          {{#if shieldStacks}}
            <div class="resource-bar-fill shield-fill"
                 style="width:{{clamp shieldWidth 0 100}}%;left:{{clamp shieldOffset 0 100}}%;">
            </div>
          {{/if}}
          {{!-- 混乱阈值刻度线（白色细竖线叠加在血条上） --}}
          {{#each chaosThresholds}}
            <div class="chaos-mark {{#if triggered}}chaos-mark-burned{{/if}}"
                 style="left:{{chaosLinePos percent}};"
                 title="混乱阈值 {{percent}}%{{#if triggered}} (已烧断){{/if}}">
            </div>
          {{/each}}
        </div>
        <div class="resource-values">
          {{#if isEditable}}
            <input type="number" name="system.hp.value" value="{{system.hp.value}}"
                   class="hp-value editable-field" min="0" disabled/>
          {{else}}
            <span class="hp-value">{{system.hp.value}}</span>
          {{/if}}
          <span class="resource-sep">/</span>
          {{#if isEditable}}
            <input type="number" name="system.hp.max" value="{{system.hp.max}}"
                   class="hp-max editable-field" min="1" disabled/>
          {{else}}
            <span class="hp-max">{{system.hp.max}}</span>
          {{/if}}
          {{#if shieldStacks}}
            <span class="shield-display" title="护盾">🛡{{shieldStacks}}</span>
          {{/if}}
        </div>
      </div>
      <button class="hp-reset resource-reset" title="重置生命值">
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/重置.webp" class="reset-icon" alt="reset">
      </button>
    </div>

    {{!-- B：理智值行（模板与HP行同步，无混乱阈值） --}}
    <div class="resource-row sanity-row {{#if isInPanic}}sanity-panic{{/if}}">
      <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/Sanity.webp" class="resource-icon" alt="理智">
      <div class="resource-bar-wrap">
        <div class="resource-bar sanity-bar">
          <div class="resource-bar-fill sanity-fill" style="width:{{clamp sanityPercent 0 100}}%"></div>
        </div>
        <div class="resource-values">
          {{#if isEditable}}
            <input type="number" name="system.sanity.value" value="{{system.sanity.value}}"
                   class="sanity-value editable-field" min="5" max="95" disabled/>
          {{else}}
            <span class="sanity-value">{{system.sanity.value}}</span>
          {{/if}}
          <span class="resource-sep">/95</span>
          {{#if isInPanic}}<span class="panic-label">陷入恐慌</span>{{/if}}
        </div>
      </div>
      <button class="sanity-reset resource-reset" title="重置理智">
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/重置.webp" class="reset-icon" alt="reset">
      </button>
    </div>

  </div>{{!-- /header-left --}}

  {{!-- ── 中列：基础信息 + 抗性信息 ────────────────────────────────── --}}
  <div class="header-col header-mid">

    {{!-- 基础信息栏（200×24px 标题 + 220×50px 内容行） --}}
    <div class="info-block basic-info">
      <div class="info-block-label">基础信息</div>
      <div class="info-row">
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/Offense_Level.webp" class="info-icon" alt="ATK" title="攻击等级">
        <span class="info-sign">{{atkTotal}}</span>
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/Defense_Level.webp" class="info-icon" alt="DEF" title="防御等级">
        <span class="info-sign">{{defTotal}}</span>
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/Speed.webp" class="info-icon" alt="SPD" title="速度">
        <span class="info-val">{{speedDisplay.min}}-{{speedDisplay.max}}</span>
      </div>
    </div>

    {{!-- 抗性信息栏（200×24px 标题 + 220×50px 内容行） --}}
    <div class="info-block resist-info">
      <div class="info-block-label">抗性信息</div>
      <div class="info-row">
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/slash.webp"  class="resist-icon" alt="斩" title="斩击">
        <span class="resist-val {{#isResistWeak displayResistances.slash}}resist-weak{{/isResistWeak}}{{#isResistStrong displayResistances.slash}}resist-strong{{/isResistStrong}}">
          {{displayResistances.slash}}
        </span>
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/blunt.webp"  class="resist-icon" alt="打" title="打击">
        <span class="resist-val {{#isResistWeak displayResistances.blunt}}resist-weak{{/isResistWeak}}{{#isResistStrong displayResistances.blunt}}resist-strong{{/isResistStrong}}">
          {{displayResistances.blunt}}
        </span>
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/pierce.webp" class="resist-icon" alt="突" title="突刺">
        <span class="resist-val {{#isResistWeak displayResistances.pierce}}resist-weak{{/isResistWeak}}{{#isResistStrong displayResistances.pierce}}resist-strong{{/isResistStrong}}">
          {{displayResistances.pierce}}
        </span>
      </div>
    </div>

  </div>{{!-- /header-mid --}}

  {{!-- ── 右列：背景 + 名字 + 长休 + 六属性 ───────────────────────── --}}
  <div class="header-col header-right">

    {{!-- D：背景标签（200×25px）+ 玩家名字（200×50px）+ 长休按钮 --}}
    <div class="name-block">
      <div class="name-row-top">
        {{#if backgroundName}}
          <span class="bg-tag bg-tag-set" data-action="open-background-item" title="点击查看背景物品">{{backgroundName}}</span>
        {{else}}
          <button type="button" class="bg-add-btn" data-action="open-background-wizard" title="选择背景">
            <i class="fas fa-plus"></i> 添加背景
          </button>
        {{/if}}
        {{!-- <button class="long-rest-btn" title="长休：重置HP/理智/AP/混乱阈值">长休</button> --}}
      </div>
      <div class="name-row-main">
        {{#if isEditable}}
          <input type="text" name="name" value="{{actor.name}}"
                 class="actor-name-input editable-field" disabled/>
        {{else}}
          <span class="actor-name-display">{{actor.name}}</span>
        {{/if}}
      </div>
    </div>

    {{!-- E：六属性（360×80px，居中排列，每格50×60px） --}}
    <div class="attributes-block">
      {{#each attributes}}
        <div class="attr-item">
          <div class="attr-label">{{label}}</div>
          {{#if ../isEditable}}
            <input type="number" name="system.attributes.{{key}}" value="{{value}}"
                   class="attr-value editable-field" min="2" max="10" disabled/>
          {{else}}
            <div class="attr-value">{{value}}</div>
          {{/if}}
          <button class="attr-check-btn" data-attr="{{key}}" title="{{label}}鉴定"></button>
        </div>
      {{/each}}
    </div>

  </div>{{!-- /header-right --}}

</header>
