{{!-- tab-combat.hbs — 战斗 Tab：BUFF状态 + 战斗技能区 + 行动值 --}}
<div class="tab-inner tab-combat-inner">

  {{!-- ── 左侧：状态栏 ─────────────────────────────────────────────── --}}
  <div class="combat-status-panel">
    <div class="combat-status-title">状态栏</div>

    {{!-- BUFF 列表表头 --}}
    <div class="buff-list-wrap">
      <div class="buff-list-header">
        <span class="buff-col-icon"></span>
        <span class="buff-col-name">名称</span>
        <span class="buff-col-intensity">强度</span>
        <span class="buff-col-stacks">层数</span>
        <span class="buff-col-actions">操作</span>
      </div>
      <ul class="buff-list">
        {{#each buffs}}
          <li class="buff-row {{#if (eq whenAdded '下回合')}}buff-row--next-turn{{/if}}"
              data-buff-id="{{id}}">
            <span class="buff-col-icon">
              {{#if icon}}
                <img src="{{icon}}" width="16" height="16" alt="{{name}}">
              {{else}}
                <span class="buff-icon-placeholder"></span>
              {{/if}}
            </span>
            <span class="buff-col-name buff-name">
              {{name}}
              {{#if (eq whenAdded '下回合')}}<span class="buff-next-turn-badge">下回合</span>{{/if}}
            </span>
            <span class="buff-col-intensity">
              <input class="buff-inline-input editable-field" type="number"
                     data-buff-id="{{id}}" data-field="intensity"
                     value="{{intensity}}" min="0" disabled>
            </span>
            <span class="buff-col-stacks">
              <input class="buff-inline-input editable-field" type="number"
                     data-buff-id="{{id}}" data-field="stacks"
                     value="{{stacks}}" min="0" disabled>
            </span>
            <span class="buff-col-actions">
              <button class="buff-trigger action-btn" title="触发">触发</button>
              <button class="buff-delete action-btn" title="删除">删除</button>
            </span>
          </li>
        {{else}}
          <li class="buff-empty">无状态</li>
        {{/each}}
      </ul>
    </div>

    {{!-- 添加BUFF按钮 --}}
    <button class="add-buff-btn">＋ 添加新的状态BUFF</button>

  </div>{{!-- /combat-status-panel --}}

  {{!-- ── 右侧：战斗技能区 ──────────────────────────────────────────── --}}
  <div class="combat-skills-panel">

    {{!-- 基础技能区 --}}
    <div class="combat-section basic-combat-section">
      <div class="combat-section-header">
        <span class="combat-section-title">基础技能</span>
        <button class="combat-activate-btn" title="激活：载入已装备技能并随机排序">激活</button>
        <button class="combat-clear-btn" title="清除战斗槽，重置6-bag">清除</button>
      </div>

      {{!-- 6个技能格（横向排列） --}}
      <div class="combat-skill-slots-row">
        {{#each basicCombatSlots}}
          <div class="combat-skill-slot-wrap">
            <div class="combat-skill-slot skill-slot-octa slot-empty"
                 data-slot-index="{{slotIndex}}">
              <img src="" class="combat-skill-img" alt="">
            </div>
            {{!-- 技能名称（小字） --}}
            <div class="combat-slot-name"></div>
            {{!-- 激活/预备状态指示点 --}}
            <div class="slot-state-dot"></div>
            {{!-- 相关技能切换按钮（有绑定相关技能时才显示） --}}
            <button class="combat-skill-related-toggle" style="display:none" title="切换相关技能">↺</button>
          </div>
        {{/each}}
      </div>

    </div>{{!-- /basic-combat-section --}}

    {{!-- EGO / 守备技能区 --}}
    <div class="combat-section ego-combat-section">
      <div class="combat-section-header">
        <span class="combat-section-title">E.G.O / 守备技能</span>
      </div>

      <div class="combat-skill-slots-row">

        {{!-- 5个EGO圆形槽 --}}
        {{#each egoSkills}}
          <div class="combat-skill-slot-wrap">
            <div class="combat-skill-slot skill-slot-circle combat-ego-slot {{#if item}}slot-equipped{{else}}slot-empty{{/if}}"
                 {{#if item}}
                   data-item-id="{{item._id}}"
                   style="border-color:{{sinColor item.system.sinType}}"
                 {{/if}}
                 title="{{#if item}}{{item.name}}{{else}}{{grade}}{{/if}}">
              <img src="{{skillImg}}" class="combat-skill-img" alt="{{grade}}">
            </div>
            <button class="combat-skill-related-toggle" style="display:none" title="切换相关技能">↺</button>
          </div>
        {{/each}}

        {{!-- 1个守备技能格（八边形以区分EGO） --}}
        <div class="combat-skill-slot-wrap">
          <div class="combat-skill-slot skill-slot-octa combat-defense-slot {{#if defenseSkill.item}}slot-equipped{{else}}slot-empty{{/if}}"
               {{#if defenseSkill.item}}
                 data-item-id="{{defenseSkill.item._id}}"
                 style="border-color:{{sinColor defenseSkill.item.system.sinType}}"
               {{/if}}
               title="{{#if defenseSkill.item}}{{defenseSkill.item.name}}{{else}}守备技能{{/if}}">
            <img src="{{defenseSkill.skillImg}}" class="combat-skill-img" alt="守备">
          </div>
          <button class="combat-skill-related-toggle" style="display:none" title="切换相关技能">↺</button>
        </div>

      </div>{{!-- /combat-skill-slots-row --}}

    </div>{{!-- /ego-combat-section --}}

    {{!-- 行动值 / 先攻合并区 --}}
    <div class="combat-section ap-initiative-section">
      <div class="combat-section-header">
        <span class="combat-section-title">行动值 / 先攻</span>
        <button class="ap-reset-btn" title="恢复行动点至上限">重置</button>
        <button class="ap-clear-btn" title="清零所有行动点">清除</button>
        <button class="roll-initiative-btn" title="骰掷先攻：1D6 + 敏捷">骰掷先攻</button>
      </div>
      <div class="ap-initiative-row">
        {{!-- AP 硬币 --}}
        <div class="ap-coins-row">
          {{#each apCoins}}
            <div class="ap-coin {{#if active}}ap-coin-active{{else}}ap-coin-inactive{{/if}}"
                 data-index="{{index}}"
                 title="行动点 {{index}}">
              <img src="{{#if active}}systems/limbusCompany_FVTT/assets/icons/Base_icon/硬币_正面.webp{{else}}systems/limbusCompany_FVTT/assets/icons/Base_icon/硬币_反面.webp{{/if}}"
                   width="36" height="36" alt="AP">
            </div>
          {{/each}}
        </div>
        {{!-- 分隔 --}}
        <div class="ap-initiative-sep"></div>
        {{!-- 先攻速度范围 --}}
        <div class="initiative-display-row">
          <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/Speed.webp"
               class="initiative-speed-icon" alt="速度" width="16" height="16">
          <span class="initiative-speed-range">{{speedDisplay.min}}–{{speedDisplay.max}}</span>
        </div>
      </div>
    </div>{{!-- /ap-initiative-section --}}

    {{!-- 罪孽抗性区 --}}
    <div class="combat-section sin-resist-section">
      <div class="combat-section-header">
        <span class="combat-section-title">罪孽抗性</span>
      </div>
      <div class="sin-resist-row">
        {{#each sinResistances}}
          <div class="sin-resist-item" title="{{label}}：{{value}}">
            <img src="{{icon}}" class="sin-resist-icon" alt="{{label}}"
                 style="border-color:{{color}};">
            <select class="sin-resist-select editable-field editable-only" name="{{field}}" disabled style="display:none">
              {{#each ../resistanceValues}}
                <option value="{{this}}" {{#if (eq this ../value)}}selected{{/if}}>{{this}}</option>
              {{/each}}
            </select>
            <span class="sin-resist-val sin-resist-static {{#isResistWeak value}}resist-weak{{/isResistWeak}}{{#isResistStrong value}}resist-strong{{/isResistStrong}}">{{value}}</span>
          </div>
        {{/each}}
      </div>
    </div>{{!-- /sin-resist-section --}}

  </div>{{!-- /combat-skills-panel --}}

</div>
