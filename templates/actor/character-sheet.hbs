{{!-- character-sheet.hbs — 角色卡主框架 --}}
<form class="limbuscompany actor character-sheet" autocomplete="off">

  {{!-- ── 顶部三列区域 ──────────────────────────────────────────────── --}}
  {{> systems/limbusCompany_FVTT/templates/actor/parts/header.hbs}}

  {{!-- ── Tab 导航 ──────────────────────────────────────────────────── --}}
  <nav class="sheet-tabs tabs" data-group="main">
    <a class="item {{#eq activeTab 'items'}}active{{/eq}}" data-tab="items">物品</a>
    <a class="item {{#eq activeTab 'skills'}}active{{/eq}}" data-tab="skills">技能</a>
    <a class="item {{#eq activeTab 'combat'}}active{{/eq}}" data-tab="战斗">战斗</a>
  </nav>

  {{!-- ── Tab 内容区 ──────────────────────────────────────────────────── --}}
  <div class="sheet-body">

    <div class="tab" data-tab="items">
      {{> systems/limbusCompany_FVTT/templates/actor/parts/tab-items.hbs}}
    </div>

    <div class="tab" data-tab="skills">
      {{> systems/limbusCompany_FVTT/templates/actor/parts/tab-skills.hbs}}
    </div>

    <div class="tab" data-tab="战斗">
      {{> systems/limbusCompany_FVTT/templates/actor/parts/tab-combat.hbs}}
    </div>

  </div>

  {{!-- ── 底部固定栏（眼货币 + 星芒） ──────────────────────────────── --}}
  <div class="sheet-footer">
    <div class="footer-left">
      <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/眼.webp" class="footer-icon" alt="眼">
      {{#if isEditable}}
        <input type="number" name="system.currency" value="{{system.currency}}" class="footer-currency editable-field" min="0" disabled/>
      {{else}}
        <span class="footer-currency">{{system.currency}}</span>
      {{/if}}
    </div>
    <div class="footer-right">
      <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/Starlight.webp" class="footer-icon" alt="星芒">
      <span class="footer-stellar-val">{{system.stellarMotes.value}}</span>
      <span class="footer-stellar-sep">/</span>
      <span class="footer-stellar-max">{{system.stellarMotes.max}}</span>
    </div>
  </div>

</form>
