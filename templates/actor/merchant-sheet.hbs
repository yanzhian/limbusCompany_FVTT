{{!-- merchant-sheet.hbs — 商人（网格版）
      左＝当前玩家角色背包、右＝商人货架，两块都是 helpers/grid-* 那一套。 --}}
<form class="limbuscompany merchant-sheet mc-sheet" autocomplete="off">

  {{!-- ── 顶部：立绘 + 店名 + 描述 ─────────────────────────────────── --}}
  <div class="mc-head">
    <div class="mc-portrait-wrap">
      {{#if (and isGM editUnlocked)}}
        <img src="{{actor.img}}" class="mc-portrait mc-portrait-edit" data-edit="img"
             title="点击更换商人立绘" alt="{{actor.name}}">
      {{else}}
        <img src="{{actor.img}}" class="mc-portrait" alt="{{actor.name}}">
      {{/if}}
      {{#if isGM}}
        <span class="sheet-lock-toggle mc-lock {{#if editUnlocked}}unlocked{{else}}locked{{/if}}"
              title="{{#if editUnlocked}}点击锁定{{else}}点击解锁（GM 编辑立绘 / Token / 店名）{{/if}}">
          <i class="fas fa-{{#if editUnlocked}}lock-open{{else}}lock{{/if}}"></i>
        </span>
      {{/if}}
    </div>
    <div class="mc-head-info">
      {{#if (and isGM editUnlocked)}}
        <input type="text" name="name" value="{{actor.name}}" class="mc-name-input">
        <div class="mc-token-row">
          <img src="{{tokenImg}}" class="mc-token-img mc-token-edit" title="点击更换 Token 图" alt="token">
          <span class="mc-token-tip">Token 图</span>
        </div>
      {{else}}
        <div class="mc-name">{{actor.name}}</div>
      {{/if}}
      {{#if (and isGM editUnlocked)}}
        <textarea name="system.shopDesc" class="mc-desc-input" rows="2"
                  placeholder="店铺描述…">{{system.shopDesc}}</textarea>
      {{else}}
        <div class="mc-desc">{{{linkify system.shopDesc}}}</div>
      {{/if}}
    </div>
  </div>

  {{!-- ── GM 工具条：折扣 / 上架提示 ───────────────────────────────── --}}
  {{#if isGM}}
    <div class="mc-gmbar">
      <span class="mc-sale-toggle mc-chip {{#if system.sale.enabled}}on{{/if}}">打折开关</span>
      <span class="mc-closed-toggle mc-chip {{#if system.closed}}on closed{{/if}}"
            title="打烊后玩家看不到货架商品，也不能买卖">{{#if system.closed}}已打烊{{else}}打烊{{/if}}</span>
      <label>折扣</label>
      <input type="range" class="mc-sale-rate" min="1" max="10" step="0.5"
             value="{{system.sale.rate}}">
      <span class="mc-sale-num">{{saleRateLabel}}</span>
      <span class="mc-gm-hint">10 折＝原价　·　把物品从侧栏拖进右边货架即可上架　·　双击商品改价/下架</span>
    </div>
  {{/if}}

  {{!-- ── 主体：左右两块网格 ───────────────────────────────────────── --}}
  <div class="mc-body">

    {{!-- ══ 左：玩家角色背包 ══ --}}
    <section class="mc-col mc-col--pl">
      <header class="mc-col-hd">
        {{#if myChar}}
          <img src="{{myChar.img}}" class="mc-av" alt="{{myChar.name}}">
          <div class="mc-col-t">
            <b>{{myChar.name}}</b>
            <span>拖到右边货架＝出售</span>
          </div>
          <div class="mc-purse">持有 <b class="mc-eye">{{myChar.currency}}</b>
            <img class="mc-eye-ic" src="{{eyeIcon}}" alt="眼"></div>
        {{else}}
          <div class="mc-col-t"><b>未指定角色</b><span>在用户配置里选一个主控角色</span></div>
        {{/if}}
      </header>

      {{#if myChar}}
        <div class="mc-toolbar">
          <span class="mc-multi-toggle mc-chip {{#if multi}}on blue{{/if}}">多选</span>
          {{#if multi}}
            <span class="mc-trade-btn mc-chip">一键买卖</span>
            <span class="mc-clear-sel mc-chip">清空选择</span>
          {{/if}}
          <span class="mc-tip">{{selInfo}}</span>
        </div>

        <div class="mc-grid-box">
          <div class="cg-wrap mc-cg mc-cg--bag"
               style="--grid-cols:{{myChar.cols}};--grid-rows:{{myChar.rows}}">
            {{#each myChar.cells}}
              <div class="cg-cell {{#if occupied}}cg-occupied{{/if}}"
                   style="grid-column:{{col}};grid-row:{{row}}"
                   data-x="{{x}}" data-y="{{y}}"></div>
            {{/each}}
            {{#each myChar.tiles}}
              <div class="cg-item-tile mc-tile mc-tile--bag rarity-{{rarity}} {{#if selected}}mc-sel{{/if}}"
                   style="grid-column:{{col}} / span {{w}};grid-row:{{row}} / span {{h}}"
                   data-item-uuid="{{uuid}}" data-item-id="{{id}}" data-side="bag"
                   title="{{name}}">
                <span class="mc-tick">✔</span>
                <img src="{{img}}" class="cg-tile-icon" alt="{{name}}">
                <span class="cg-tile-name">{{name}}</span>
                {{#if showQty}}<span class="mc-qty">×{{quantity}}</span>{{/if}}
                <span class="mc-price mc-price--sell">{{sellPrice}}<img class="mc-eye-ic" src="{{../eyeIcon}}" alt="眼"></span>
              </div>
            {{/each}}
          </div>
        </div>
      {{/if}}
    </section>

    {{!-- ══ 右：商人货架 ══ --}}
    <section class="mc-col mc-col--shop">
      <header class="mc-col-hd">
        <img src="{{actor.img}}" class="mc-av" alt="{{actor.name}}">
        <div class="mc-col-t">
          <b>货架</b>
          <span>{{#if isGM}}GM：可整理、双击改价/下架{{else}}双击商品购买{{/if}}</span>
        </div>
        <div class="mc-purse">
          {{#if (and isGM editUnlocked)}}
            <input type="number" name="system.merchantCurrency" class="mc-eye-input"
                   value="{{system.merchantCurrency}}" min="0">
          {{else}}
            <b class="mc-eye">{{system.merchantCurrency}}</b>
          {{/if}}
          <img class="mc-eye-ic" src="{{eyeIcon}}" alt="眼"></div>
      </header>

      <div class="mc-toolbar">
        {{#each catFilters}}
          <span class="mc-cat mc-chip {{#if on}}on{{/if}}" data-cat="{{key}}">{{label}}</span>
        {{/each}}
      </div>

      <div class="mc-grid-box">
        {{#if closedForMe}}<div class="mc-closed-veil">已 打 烊</div>{{/if}}
        <div class="cg-wrap mc-cg mc-cg--shop"
             style="--grid-cols:{{shelfCols}};--grid-rows:{{shelfRows}}">
          {{#each shelfCells}}
            <div class="cg-cell {{#if occupied}}cg-occupied{{/if}}"
                 style="grid-column:{{col}};grid-row:{{row}}"
                 data-x="{{x}}" data-y="{{y}}"></div>
          {{/each}}
          {{#each shelfItems}}
            <div class="cg-item-tile mc-tile mc-tile--shop rarity-{{rarity}}
                        {{#unless show}}mc-dim{{/unless}}
                        {{#if selected}}mc-sel{{/if}}
                        {{#unless affordable}}mc-poor{{/unless}}"
                 style="grid-column:{{col}} / span {{w}};grid-row:{{row}} / span {{h}}"
                 data-item-uuid="{{uuid}}" data-placement-idx="{{idx}}" data-side="shop"
                 title="{{name}}">
              <span class="mc-tick">✔</span>
              <img src="{{img}}" class="cg-tile-icon" alt="{{name}}">
              <span class="cg-tile-name">{{name}}</span>
              {{#if showQty}}<span class="mc-qty">×{{quantity}}</span>{{/if}}
              <span class="mc-price">
                {{#if discounted}}<s>{{basePrice}}</s> {{/if}}{{buyPrice}}<img class="mc-eye-ic" src="{{../eyeIcon}}" alt="眼">
              </span>
            </div>
          {{/each}}
        </div>
      </div>
    </section>

  </div>{{!-- /mc-body --}}
</form>
