{{!-- combat-hud.hbs — 对抗确认弹窗（拼点技能选择器） --}}
<div class="limbuscompany combat-hud">
  <div class="combat-hud-title">{{title}}</div>

  {{!-- 顶部3格（优先显示激活+守备） --}}
  <div class="hud-top-slots">
    {{#each topSkills}}
      <div class="hud-skill-slot {{#if this}}hud-slot-filled{{else}}hud-slot-empty{{/if}}
                                  {{#if selected}}hud-slot-selected{{/if}}"
           data-item-id="{{#if this}}{{this._id}}{{/if}}"
           title="{{#if this}}{{this.name}}{{else}}空{{/if}}">
        <img src="{{#if this}}{{this.img}}{{else}}systems/limbusCompany_FVTT/assets/icons/Skill/Normalsin.webp{{/if}}"
             class="hud-skill-img"
             alt="{{#if this}}{{this.name}}{{else}}空{{/if}}">
        {{#if this}}
          <div class="hud-skill-name">{{this.name}}</div>
          <div class="hud-skill-formula">{{fmtDice this.system.diceFormula}}</div>
        {{/if}}
      </div>
    {{/each}}
  </div>

  {{!-- 展开/折叠箭头 --}}
  <div class="hud-expand-toggle">▼</div>

  {{!-- 展开区域（默认隐藏） --}}
  <div class="hud-expanded-area" style="display:none">

    {{!-- 展开后的箭头 --}}
    <div class="hud-collapse-toggle">▲</div>

    {{!-- 基础技能（其余） --}}
    <div class="hud-basic-grid">
      {{#each basicSkills}}
        <div class="hud-skill-slot {{#if this}}hud-slot-filled{{else}}hud-slot-empty{{/if}}"
             data-item-id="{{#if this}}{{this._id}}{{/if}}"
             title="{{#if this}}{{this.name}}{{else}}空{{/if}}">
          <img src="{{#if this}}{{this.img}}{{else}}systems/limbusCompany_FVTT/assets/icons/Skill/Normalsin.webp{{/if}}"
               class="hud-skill-img" alt="">
        </div>
      {{/each}}
    </div>

    {{!-- EGO技能 --}}
    <div class="hud-ego-row">
      {{#each egoSkills}}
        <div class="hud-skill-slot hud-skill-circle {{#if item}}hud-slot-filled{{else}}hud-slot-empty{{/if}}"
             data-item-id="{{#if item}}{{item._id}}{{/if}}"
             title="{{#if item}}{{item.name}}{{else}}{{grade}}{{/if}}">
          <img src="{{#if item}}{{item.img}}{{else}}systems/limbusCompany_FVTT/assets/icons/Skill/Normalsin.webp{{/if}}"
               class="hud-skill-img" alt="{{grade}}">
          <div class="hud-ego-grade">{{grade}}</div>
        </div>
      {{/each}}
    </div>

  </div>{{!-- /hud-expanded-area --}}

</div>
