{{!-- sin-resource-hud.hbs — 全局罪孽资源浮动面板 --}}
<div id="limbus-sin-resource-hud" class="limbus-sin-hud">

  {{!-- 标题（hover 时显示，idle 时渐隐） --}}
  <div class="sin-hud-title">罪孽资源</div>

  {{!-- 主体条 --}}
  <div class="sin-hud-bar">

    {{#each entries}}
      <div class="sin-hud-entry" title="{{label}}">
        <img class="sin-hud-icon" src="{{icon}}" alt="{{label}}"
             style="border-color: {{color}};">
        {{#if ../isGM}}
          <input class="sin-hud-value-input" type="number"
                 data-sin="{{key}}" value="{{value}}" min="0">
        {{else}}
          <span class="sin-hud-value" style="color: {{color}};">{{value}}</span>
        {{/if}}
      </div>
    {{/each}}

    {{!-- 重置按钮（仅 GM 可见） --}}
    {{#if isGM}}
      <button class="sin-hud-reset" title="重置所有罪孽资源为零">
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/重置.webp"
             alt="重置" width="28" height="28">
      </button>
    {{/if}}

    {{!-- 场地资源：仅显示已激活的条目，位置紧邻七宗罪池 --}}
    {{#if fieldEntries.length}}
      <div class="field-hud-divider"></div>
      {{#each fieldEntries}}
        <div class="field-hud-entry" title="场地资源：{{name}}">
          <span class="field-hud-name">{{name}}</span>
          {{#if ../isGM}}
            <input class="field-hud-value-input" type="number"
                   data-field="{{name}}" value="{{value}}" min="0">
            <button class="field-hud-remove" data-field="{{name}}" title="移除该场地资源">×</button>
          {{else}}
            <span class="field-hud-value">{{value}}</span>
          {{/if}}
        </div>
      {{/each}}
    {{/if}}

  </div>{{!-- /sin-hud-bar --}}

</div>
