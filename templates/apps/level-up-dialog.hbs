{{!-- level-up-dialog.hbs — 角色升级对话框（两阶段） --}}
<div class="lud-root">
  <div class="lud-card-title">升级</div>
  {{#if bgName}}<div class="lud-card-subtitle">{{bgName}}</div>{{/if}}

  {{#if preview}}

    {{#if (eq step 1)}}
      <div class="lud-section-title">提升生命值/星光</div>
      <div class="lud-rows">
        <div class="lud-row">
          <span class="lud-label">您的等级</span>
          <span class="lud-value">{{preview.currentLevel}}</span>
          <span class="lud-arrow">→</span>
          <span class="lud-value lud-value-new">{{preview.nextLevel}}</span>
          {{#if (gt preview.levelsGained 1)}}
            <span class="lud-multi">连升 {{preview.levelsGained}} 级</span>
          {{/if}}
        </div>
        <div class="lud-row">
          <span class="lud-label">您的经验</span>
          <span class="lud-value">{{preview.xpFrom}}</span>
          <span class="lud-arrow">→</span>
          <span class="lud-value lud-value-new">{{preview.xpTo}}</span>
        </div>
        <div class="lud-row">
          <span class="lud-label">您的生命值</span>
          <span class="lud-value">{{preview.hpFrom}}</span>
          <span class="lud-arrow">→</span>
          <span class="lud-value lud-value-new">{{preview.hpTo}}</span>
        </div>
        <div class="lud-row">
          <span class="lud-label">您的星光</span>
          <span class="lud-value">{{preview.stellarFrom}}</span>
          <span class="lud-arrow">→</span>
          <span class="lud-value lud-value-new">{{preview.stellarTo}}</span>
        </div>
      </div>
      <div class="lud-footer">
        <button type="button" class="lud-next sheet-btn">下一步</button>
      </div>
    {{/if}}

    {{!-- 第 2 步：训练等级强化。已装备的排在前面，但技能列表里没装的同样能挑 --}}
    {{#if (eq step 2)}}
      <div class="lud-section-title">强化训练等级</div>
      <div class="lud-train-hint">
        还可强化 <b>{{trainLeft}}</b> 次 —— 点一个技能把它的训练等级提升一阶
      </div>
      {{#if trainDone.length}}
        <div class="lud-train-done">
          {{#each trainDone}}<span>{{name}} {{from}}→{{to}}</span>{{/each}}
        </div>
      {{/if}}
      <div class="lud-train-list">
        {{#each candidates}}
          <div class="lud-train-row{{#unless canUpgrade}} disabled{{/unless}}{{#if equipped}} equipped{{/if}}"
               data-item-id="{{id}}"
               title="{{#if maxed}}已经是 Ⅴ 阶，无法再强化{{else if hasNextData}}强化到 {{nextNumeral}} 阶{{else}}这张卡还没写 {{nextNumeral}} 阶的数值，强化了也不会有变化{{/if}}">
            <img src="{{img}}" class="lud-train-icon" alt="{{name}}">
            <span class="lud-train-name">{{name}}</span>
            {{#if equipped}}<span class="lud-train-slot">{{slotLabel}}</span>{{/if}}
            <span class="lud-train-lv">
              {{numeral}}{{#if canUpgrade}} <span class="lud-arrow">→</span> <b>{{nextNumeral}}</b>{{/if}}
            </span>
            {{#unless canUpgrade}}
              <span class="lud-train-warn">{{#if maxed}}已满阶{{else}}无 {{nextNumeral}} 阶数据{{/if}}</span>
            {{/unless}}
          </div>
        {{else}}
          <div class="lud-empty">没有可强化的技能</div>
        {{/each}}
      </div>
      <div class="lud-footer">
        <button type="button" class="lud-skip sheet-btn">稍后再说</button>
      </div>
    {{/if}}

    {{#if (eq step 3)}}
      <div class="lud-section-title">等级奖励物品</div>
      <div class="lud-item-list">
        {{#each preview.rewards}}
          <div class="lud-item-row" data-item-uuid="{{uuid}}" title="{{name}}">
            <img src="{{img}}" class="lud-item-icon" alt="{{name}}">
            <span class="lud-item-name">{{name}}</span>
            {{#if level}}<span class="lud-item-lv">Lv.{{level}}</span>{{/if}}
          </div>
        {{else}}
          <div class="lud-empty">本次升级无奖励物品</div>
        {{/each}}
      </div>
      <div class="lud-footer">
        <button type="button" class="lud-finish sheet-btn">完成</button>
      </div>
    {{/if}}

  {{else}}
    <div class="lud-empty">经验值未超过升级阈值，暂无法升级。</div>
    <div class="lud-footer">
      <button type="button" class="lud-cancel sheet-btn">关闭</button>
    </div>
  {{/if}}
</div>
