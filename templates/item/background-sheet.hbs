{{!-- background-sheet.hbs — 背景物品卡 --}}
<form class="limbuscompany item-sheet background-sheet" autocomplete="off">

  {{!-- ── 标题栏 ──────────────────────────────────────────────────── --}}
  <div class="item-sheet-titlebar">
    <span class="sheet-type-label">背景</span>
    <span class="sheet-lock-icon {{#if isLocked}}locked{{else}}unlocked{{/if}}" title="{{#if isLocked}}点击解锁{{else}}点击锁定{{/if}}">
      <i class="fas fa-{{#if isLocked}}lock{{else}}lock-open{{/if}}"></i>
    </span>
  </div>

  {{!-- ── 可滚动主体 ──────────────────────────────────────────────── --}}
  <div class="equip-body">

    {{!-- 顶部：图标（100×100）+ 名称/副标题 --}}
    <div class="equip-header">
      <div class="equip-icon-col">
        {{#if isEditable}}
          <img src="{{item.img}}" class="item-sheet-icon" data-edit="img" title="更换图标" alt="icon">
        {{else}}
          <img src="{{item.img}}" class="item-sheet-icon" alt="icon">
        {{/if}}
      </div>
      <div class="equip-info-col">
        <div class="equip-name-row">
          {{#if (and isEditable (not isLocked))}}
            <input type="text" name="name" value="{{item.name}}" class="item-name-input"/>
          {{else}}
            <div class="item-name-display">{{item.name}}</div>
          {{/if}}
        </div>
        <div class="equip-type-row">
          {{#if (and isEditable (not isLocked))}}
            <input type="text" name="system.subtitle" value="{{system.subtitle}}" class="equip-subtype-sel" placeholder="副标题（如：收尾人）"/>
          {{else}}
            <span class="bg-subtitle-label">{{system.subtitle}}</span>
          {{/if}}
        </div>
      </div>
    </div>

    {{!-- ── 标签（合集包分类） ─────────────────────────────────────────── --}}
    <div class="item-tags-row">
      <div class="tags-area">
        {{#if (and isEditable (not isLocked))}}
          <input type="text" name="system.category" value="{{system.category}}" class="tags-input" placeholder="合集分类（如：事务所）"/>
        {{else}}
          {{#if system.category}}<span class="tag">{{system.category}}</span>{{/if}}
        {{/if}}
      </div>
    </div>

    {{!-- ── 势力/阵营标签（供场地资源等玩法逻辑匹配） ───────────────────── --}}
    <div class="item-tags-row">
      <div class="tags-area">
        {{#if (and isEditable (not isLocked))}}
          <input type="text" name="system.tags" value="{{system.tags}}" class="tags-input" placeholder="势力标签（如：拉曼却/血魔）"/>
        {{else}}
          {{#each (split system.tags "/")}}
            {{#if this}}<span class="tag">{{trim this}}</span>{{/if}}
          {{/each}}
        {{/if}}
      </div>
    </div>

    <div class="equip-divider"></div>

    {{!-- ── 简介（富文本，支持图文） ──────────────────────────────────── --}}
    <div class="item-desc-block">
      {{#if (and isEditable (not isLocked))}}
        {{editor system.description target="system.description" button=false editable=true engine="prosemirror"}}
      {{else}}
        <div class="item-desc-display">{{{linkify system.description}}}</div>
      {{/if}}
    </div>

    <div class="equip-divider"></div>

    {{!-- ── 等级物品 ──────────────────────────────────────────────────── --}}
    <div class="bg-section-title">等级物品</div>

    <div class="bg-level-block">
      <div class="bg-level-hd">初始物品</div>
      <div class="bg-dropzone" data-level-id="">
        {{#each startingItems}}
          <div class="bg-item-chip" data-item-uuid="{{uuid}}" title="{{item.name}}">
            <img src="{{item.img}}" class="bg-item-icon" alt="{{item.name}}">
            <span class="bg-item-name">{{item.name}}</span>
            {{#if (and ../isEditable (not ../isLocked))}}
              <button type="button" class="bg-item-remove" data-ref-id="{{id}}" title="移除">×</button>
            {{/if}}
          </div>
        {{else}}
          <div class="bg-empty-hint">将物品拖入此处</div>
        {{/each}}
      </div>
    </div>

    {{#each levelRewards}}
      <div class="bg-level-block">
        <div class="bg-level-hd">
          等级
          {{#if (and ../isEditable (not ../isLocked))}}
            <input type="number" class="bg-level-input" data-level-id="{{id}}" value="{{level}}" min="1" style="width:48px;">
            <button type="button" class="bg-level-remove" data-level-id="{{id}}" title="删除此等级奖励">×</button>
          {{else}}
            {{level}}
          {{/if}}
        </div>
        <div class="bg-dropzone" data-level-id="{{id}}">
          {{#each items}}
            <div class="bg-item-chip" data-item-uuid="{{uuid}}" title="{{item.name}}">
              <img src="{{item.img}}" class="bg-item-icon" alt="{{item.name}}">
              <span class="bg-item-name">{{item.name}}</span>
              {{#if (and ../../isEditable (not ../../isLocked))}}
                <button type="button" class="bg-item-remove" data-ref-id="{{id}}" data-level-id="{{../id}}" title="移除">×</button>
              {{/if}}
            </div>
          {{else}}
            <div class="bg-empty-hint">将物品拖入此处</div>
          {{/each}}
        </div>
      </div>
    {{/each}}

    {{#if (and isEditable (not isLocked))}}
      <button type="button" class="bg-add-level sheet-btn">添加等级物品</button>
    {{/if}}

    <div class="equip-divider"></div>

  </div>{{!-- /equip-body --}}

  {{!-- ── 固定底部按钮栏 ─────────────────────────────────────────── --}}
  <div class="item-sheet-footer">
    <div class="footer-actions">
      <button class="item-send-chat sheet-btn">发送聊天框</button>
      <button type="button" class="bg-edit-rewards-btn sheet-btn">{{#if isLocked}}编辑奖励物品{{else}}完成编辑{{/if}}</button>
    </div>
  </div>

</form>
