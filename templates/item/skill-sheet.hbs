{{!-- skill-sheet.hbs — 技能物品卡（基础/守备/EGO 通用） --}}
<form class="limbuscompany item-sheet skill-sheet" autocomplete="off">

  {{!-- ── 标题栏 ──────────────────────────────────────────────────── --}}
  <div class="item-sheet-titlebar">
    <span class="sheet-lock-icon {{#if isLocked}}locked{{else}}unlocked{{/if}}" title="{{#if isLocked}}点击解锁{{else}}点击锁定{{/if}}">
      <i class="fas fa-{{#if isLocked}}lock{{else}}lock-open{{/if}}"></i>
    </span>
    <span class="sheet-type-label">技能</span>
  </div>

  {{!-- ── 可滚动主体 ──────────────────────────────────────────────── --}}
  <div class="equip-body">

    {{!-- ══ 主技能卡片 ══════════════════════════════════════════════ --}}
    <div class="skill-card-main">

      {{!-- 顶部：图标（100×100 八角形）+ 右侧信息列 --}}
      <div class="equip-header">

        {{!-- 图标 --}}
        <div class="equip-icon-col">
          <div class="skill-slot-octa skill-icon-big" style="border-color:{{sinColor}}">
            {{#if isEditable}}
              <img src="{{item.img}}" class="skill-slot-img" data-edit="img" title="更换图标" alt="icon">
            {{else}}
              <img src="{{item.img}}" class="skill-slot-img" alt="icon">
            {{/if}}
          </div>
        </div>

        {{!-- 右侧信息列 --}}
        <div class="equip-info-col">

          {{!-- 名字 --}}
          <div class="equip-name-row">
            {{#if (and isEditable (not isLocked))}}
              <input type="text" name="name" value="{{item.name}}" class="item-name-input" style="color:{{sinColor}}"/>
            {{else}}
              <div class="item-name-display" style="color:{{sinColor}}">{{item.name}}</div>
            {{/if}}
          </div>

          {{!-- 分类 + 骰数 --}}
          <div class="skill-cat-dice-row">
            {{#if (and isEditable (not isLocked))}}
              {{#if isDefense}}
                <select name="system.category" class="equip-subtype-sel">
                  {{#each defenseCategories}}
                    <option value="{{@key}}" {{#eq @key ../system.category}}selected{{/eq}}>{{this}}</option>
                  {{/each}}
                </select>
              {{else}}
                <select name="system.category" class="equip-subtype-sel">
                  {{#each attackCategories}}
                    <option value="{{@key}}" {{#eq @key ../system.category}}selected{{/eq}}>{{this}}</option>
                  {{/each}}
                </select>
              {{/if}}
              <input type="text" name="system.diceFormula" value="{{diceFormulaDisplay}}" class="dice-formula-input" placeholder="1D4+2"/>
              {{!-- 骰子类型：普通 / 不可摧毁 --}}
              {{#unless isDefense}}
                <select name="system.diceType" class="equip-subtype-sel dice-type-sel" title="骰子类型">
                  <option value="normal"      {{#eq system.diceType "normal"}}selected{{/eq}}>一般骰子</option>
                  <option value="unbreakable" {{#eq system.diceType "unbreakable"}}selected{{/eq}}>不可摧毁</option>
                </select>
              {{/unless}}
            {{else}}
              {{#if system.category}}
                <img src="{{lookup @root.config.CATEGORY_ICON_PATHS system.category}}" class="category-icon" width="22" height="22" alt="{{system.category}}">
              {{/if}}
              <span class="dice-formula-display">{{diceFormulaDisplay}}</span>
              {{#if (eq system.diceType "unbreakable")}}
                <span class="dice-type-badge unbreakable-badge" title="不可摧毁：受到伤害后自动反击（变动值+1）">不可摧毁</span>
              {{/if}}
            {{/if}}
          </div>

          {{!-- 反击伤害类型（守备且为反击/可拼点反击） --}}
          {{#if isCounterType}}
            <div class="counter-type-row">
              {{#if (and isEditable (not isLocked))}}
                <label class="counter-type-label">反击分类</label>
                <select name="system.counterType" class="equip-subtype-sel">
                  <option value="slash"  {{#if (eq system.counterType "slash")}}selected{{/if}}>斩击</option>
                  <option value="blunt"  {{#if (eq system.counterType "blunt")}}selected{{/if}}>打击</option>
                  <option value="pierce" {{#if (eq system.counterType "pierce")}}selected{{/if}}>突刺</option>
                </select>
              {{else}}
                <span class="counter-type-label">反击分类</span>
                {{#if system.counterType}}
                  <img src="{{lookup @root.config.CATEGORY_ICON_PATHS system.counterType}}" class="category-icon" width="18" height="18" alt="{{system.counterType}}">
                {{/if}}
              {{/if}}
            </div>
          {{/if}}

          {{!-- 类型 + 罪孽 + 等级 --}}
          {{#if (and isEditable (not isLocked))}}
            <div class="skill-sin-row">
              <label>类型</label>
              <select name="system.type" class="equip-subtype-sel">
                <option value="basic"   {{#if (eq system.type "basic")}}selected{{/if}}>基础技能</option>
                <option value="defense" {{#if (eq system.type "defense")}}selected{{/if}}>守备技能</option>
                <option value="ego"     {{#if (eq system.type "ego")}}selected{{/if}}>E.G.O</option>
              </select>
              <label>罪孽</label>
              <select name="system.sinType" class="equip-subtype-sel">
                {{#each skillSinTypes}}
                  <option value="{{@key}}" {{#if (eq @key ../system.sinType)}}selected{{/if}}>{{this}}</option>
                {{/each}}
              </select>
              {{#if isBasic}}
                <label>等级</label>
                <select name="system.level" class="equip-subtype-sel">
                  <option value="1" {{#if (eq system.level 1)}}selected{{/if}}>1</option>
                  <option value="2" {{#if (eq system.level 2)}}selected{{/if}}>2</option>
                  <option value="3" {{#if (eq system.level 3)}}selected{{/if}}>3</option>
                </select>
              {{/if}}
              {{#if isEgo}}
                <label>等级</label>
                <select name="system.egoDiceRating" class="equip-subtype-sel">
                  {{#each config.EGO_GRADES}}
                    <option value="{{this}}" {{#if (eq this ../system.egoDiceRating)}}selected{{/if}}>{{this}}</option>
                  {{/each}}
                </select>
              {{/if}}
            </div>
          {{else}}
            <div class="skill-type-label">
              {{#if (eq system.type "basic")}}基础技能{{/if}}
              {{#if (eq system.type "defense")}}守备技能{{/if}}
              {{#if (eq system.type "ego")}}E.G.O{{/if}}
              {{#if system.sinType}}
                <img src="{{lookup @root.config.SIN_ICON_PATHS system.sinType}}" width="14" height="14" alt="{{system.sinType}}" class="sin-type-icon">
              {{/if}}
              {{#if isBasic}}
                <span class="skill-level-badge">Lv{{system.level}}</span>
              {{/if}}
              {{#if isEgo}}
                <span class="skill-level-badge">{{system.egoDiceRating}}</span>
              {{/if}}
            </div>
          {{/if}}

          {{!-- 加重值（非守备技能） --}}
          {{#unless isDefense}}
            <div class="weight-row">
              {{#if (and isEditable (not isLocked))}}
                <label class="skill-field-label">加重值</label>
                <input type="number" name="system.weight" value="{{system.weight}}" class="weight-input" min="0" max="8" style="width:45px"/>
              {{else}}
                {{#each weightSquares}}
                  <span class="weight-sq" title="加重值"></span>
                {{/each}}
              {{/if}}
            </div>
          {{/unless}}

        </div>{{!-- /equip-info-col --}}
      </div>{{!-- /equip-header --}}

      {{!-- ── EGO 专有：罪孽消耗 / 理智消耗 / 调整罪孽抗性 ────────── --}}
      {{#if isEgo}}

        {{!-- 罪孽消耗 --}}
        <div class="ego-row-wrap">
          <span class="ego-row-label">罪孽消耗</span>
          <div class="ego-cost-block">
            {{#each sinCosts}}
              <div class="ego-cost-item">
                {{#if ../isEditable}}
                  <select name="system.sinCost.{{@index}}.sinType" class="sin-cost-sel">
                    {{#each @root.config.SINS}}
                      <option value="{{this}}" {{#if (eq this ../sinType)}}selected{{/if}}>{{lookup @root.config.SIN_LABELS_ZH this}}</option>
                    {{/each}}
                  </select>
                  <input type="number" name="system.sinCost.{{@index}}.amount" value="{{amount}}" class="sin-cost-input" min="0" style="width:40px"/>
                  <button type="button" class="sin-cost-remove-btn" data-idx="{{@index}}">×</button>
                {{else}}
                  <img src="{{lookup @root.config.SIN_ICON_PATHS sinType}}" width="16" height="16" alt="{{sinType}}">
                  <span>{{amount}}</span>
                {{/if}}
              </div>
            {{/each}}
            {{#if (and isEditable (not isLocked))}}
              <button type="button" class="sin-cost-add-btn">＋</button>
            {{/if}}
          </div>
        </div>

        {{!-- 理智消耗 --}}
        <div class="ego-row-wrap">
          <span class="ego-row-label">理智消耗</span>
          {{#if (and isEditable (not isLocked))}}
            <input type="number" name="system.sanityCost" value="{{system.sanityCost}}" class="weight-input" min="0" style="width:50px"/>
          {{else}}
            <span class="ego-sanity-val">{{#if system.sanityCost}}-{{system.sanityCost}}{{else}}—{{/if}}</span>
          {{/if}}
        </div>

        {{!-- 调整罪孽抗性 --}}
        <div class="ego-row-wrap">
          <span class="ego-row-label">调整罪孽抗性</span>
          <div class="ego-resist-block">
            {{#each egoResChanges}}
              <div class="ego-resist-item">
                {{#if ../isEditable}}
                  <select name="system.egoResistanceAdj.{{@index}}.sinType" class="sin-cost-sel">
                    {{#each @root.config.SINS}}
                      <option value="{{this}}" {{#if (eq this ../sinType)}}selected{{/if}}>{{lookup @root.config.SIN_LABELS_ZH this}}</option>
                    {{/each}}
                  </select>
                  <select name="system.egoResistanceAdj.{{@index}}.multiplier" class="sin-cost-sel">
                    {{#each @root.config.RESISTANCE_VALUES}}
                      <option value="{{this}}" {{#if (eq this ../multiplier)}}selected{{/if}}>{{this}}</option>
                    {{/each}}
                  </select>
                  <button type="button" class="res-change-remove-btn" data-idx="{{@index}}">×</button>
                {{else}}
                  <span>{{sinType}}×{{multiplier}}</span>
                {{/if}}
              </div>
            {{/each}}
            {{#if (and isEditable (not isLocked))}}
              <button type="button" class="res-change-add-btn">＋</button>
            {{/if}}
          </div>
        </div>

      {{/if}}{{!-- /isEgo --}}

      {{!-- ── 标签行 ──────────────────────────────────────────────── --}}
      <div class="skill-tags-row">
        {{#if (and isEditable (not isLocked))}}
          <input type="text" name="system.tags" value="{{system.tags}}" class="tags-input" placeholder="标签1/标签2"/>
        {{else}}
          <div class="skill-tags">
            {{#each (split system.tags '/')}}
              <span class="tag">{{trim this}}</span>
            {{/each}}
          </div>
        {{/if}}
      </div>

      {{!-- ── 分割线 ──────────────────────────────────────────────── --}}
      <div class="equip-divider"></div>

      {{!-- ── 描述区 ──────────────────────────────────────────────── --}}
      <div class="item-desc-block">
        {{#if (and isEditable (not isLocked))}}
          {{editor system.effectDesc target="system.effectDesc" button=false editable=true engine="prosemirror"}}
        {{else}}
          <div class="item-desc-display">{{{linkify system.effectDesc}}}</div>
        {{/if}}
      </div>

      {{!-- ── 分割线 ──────────────────────────────────────────────── --}}
      <div class="equip-divider"></div>

      {{!-- ── 活动编辑器（展开时显示在底部上方） ────────────────── --}}
      {{#if activitiesExpanded}}
        {{> systems/limbusCompany_FVTT/templates/partials/activity-editor.hbs}}
      {{/if}}

    </div>{{!-- /skill-card-main --}}

  </div>{{!-- /equip-body --}}

  {{!-- ── 固定底部按钮栏 ─────────────────────────────────────────── --}}
  <div class="item-sheet-footer">
    <div class="footer-actions">
      <button class="item-send-chat sheet-btn">发送聊天框</button>
      {{#if isDefense}}
        <button class="item-activate sheet-btn">激活</button>
      {{else}}
        <button class="item-start-clash sheet-btn">发起对抗</button>
      {{/if}}
      <button class="activity-edit-toggle sheet-btn">编辑激活效果 {{#if activitiesExpanded}}▼{{else}}▲{{/if}}</button>
    </div>
  </div>

</form>
