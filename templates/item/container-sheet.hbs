{{!-- container-sheet.hbs — 容器物品卡 --}}
<form class="limbuscompany item-sheet container-sheet" autocomplete="off">

  {{!-- ── 标题栏 ──────────────────────────────────────────────────── --}}
  <div class="item-sheet-titlebar">
    <span class="sheet-lock-icon {{#if isLocked}}locked{{else}}unlocked{{/if}}" title="{{#if isLocked}}点击解锁{{else}}点击锁定{{/if}}">
      <i class="fas fa-{{#if isLocked}}lock{{else}}lock-open{{/if}}"></i>
    </span>
    <span class="sheet-type-label">容器</span>
  </div>

  {{!-- ── 可滚动主体 ──────────────────────────────────────────────── --}}
  <div class="equip-body">

    {{!-- 顶部：图标（100×100）+ 右侧信息列 --}}
    <div class="equip-header">

      {{!-- 图标 --}}
      <div class="equip-icon-col">
        {{#if isEditable}}
          <img src="{{item.img}}" class="item-sheet-icon" data-edit="img" title="更换图标" alt="icon">
        {{else}}
          <img src="{{item.img}}" class="item-sheet-icon" alt="icon">
        {{/if}}
      </div>

      {{!-- 右侧信息列 --}}
      <div class="equip-info-col">

        {{!-- 名字 --}}
        <div class="equip-name-row">
          {{#if (and isEditable (not isLocked))}}
            <input type="text" name="name" value="{{item.name}}" class="item-name-input"/>
          {{else}}
            <div class="item-name-display">{{item.name}}</div>
          {{/if}}
        </div>

        {{!-- 类型 + 分类 --}}
        <div class="equip-type-row">
          <span class="equip-subtype-label">容器</span>
          {{#if (and isEditable (not isLocked))}}
            <input type="text" name="system.category" value="{{system.category}}" class="equip-category-input" placeholder="分类"/>
          {{else}}
            <span class="equip-sep">　</span>
            <span class="equip-category">{{system.category}}</span>
          {{/if}}
        </div>

        {{!-- 内部容量（网格尺寸） --}}
        <div class="container-size-row">
          <span class="container-size-label">内部容量</span>
          {{#if (and isEditable (not isLocked))}}
            <input type="number" name="system.gridSize.width"  value="{{system.gridSize.width}}"  class="grid-dim-input" min="1" max="10"/>
            <span class="cap-sep">×</span>
            <input type="number" name="system.gridSize.height" value="{{system.gridSize.height}}" class="grid-dim-input" min="1" max="10"/>
          {{else}}
            <span class="grid-size-display">{{gridSizeLabel}}</span>
          {{/if}}
        </div>

        {{!-- 剩余容量（未被锁定和未被占领的格子） --}}
        <div class="container-avail-row">
          <span class="container-avail-label">剩余</span>
          <span class="container-avail-val">{{containerAvail}}</span>
          <span class="container-avail-sep">/</span>
          <span class="container-avail-max">{{containerMax}}</span>
          <span class="container-avail-unit">格可用</span>
        </div>

        {{!-- 存放限制：类型 AND 分类，留空 = 不限制（多个用 / 分隔）
              锁定态下两条都为空时整行隐藏，不占版面 --}}
        {{#if (or (and isEditable (not isLocked)) system.allowTypes system.allowCategories)}}
        <div class="container-limit-row">
          <span class="container-limit-label">存放限制</span>
          {{#if (and isEditable (not isLocked))}}
            <input type="text" name="system.allowTypes" value="{{system.allowTypes}}"
                   class="container-limit-input" placeholder="类型"
                   title="存放限制·类型：留空=不限制，多个用 / 分隔（消耗品/材料）"/>
            <input type="text" name="system.allowCategories" value="{{system.allowCategories}}"
                   class="container-limit-input" placeholder="分类"
                   title="存放限制·分类：留空=不限制，多个用 / 分隔（医疗/食材）"/>
          {{else}}
            {{#if system.allowTypes}}<span class="container-limit-badge">{{system.allowTypes}}</span>{{/if}}
            {{#if system.allowCategories}}<span class="container-limit-badge">{{system.allowCategories}}</span>{{/if}}
          {{/if}}
        </div>
        {{/if}}

      </div>
    </div>

    {{!-- ── 标签 + 容量 + 眼 ──────────────────────────────────────── --}}
    <div class="item-tags-row">
      <div class="tags-area">
        {{#if (and isEditable (not isLocked))}}
          <input type="text" name="system.tags" value="{{join system.tags '/'}}" class="tags-input" placeholder="标签1/标签2"/>
        {{else}}
          {{#each (split system.tags '/')}}
            <span class="tag">{{trim this}}</span>
          {{/each}}
        {{/if}}
      </div>
      <div class="item-capacity-group">
        <span class="cap-label">容量</span>
        {{#if (and isEditable (not isLocked))}}
          <input type="number" name="system.capacity.w" value="{{system.capacity.w}}" class="cap-input" min="1" max="10"/>
          <span class="cap-sep">×</span>
          <input type="number" name="system.capacity.h" value="{{system.capacity.h}}" class="cap-input" min="1" max="10"/>
        {{else}}
          <span class="cap-display">{{system.capacity.w}}×{{system.capacity.h}}</span>
        {{/if}}
      </div>
      <div class="item-cost-group">
        <img src="systems/limbusCompany_FVTT/assets/icons/Base_icon/眼.webp" class="cost-eye-icon" alt="眼">
        {{#if (and isEditable (not isLocked))}}
          <input type="number" name="system.cost" value="{{system.cost}}" class="cost-input" min="0"/>
        {{else}}
          <span class="cost-display">{{system.cost}}</span>
        {{/if}}
      </div>
      {{!-- 稀有度：只管战利品随机池权重与网格光晕，不参与定价 --}}
      <div class="item-rarity-group rarity-{{system.rarity}}">
        <span class="rarity-dot"></span>
        {{#if (and isEditable (not isLocked))}}
          <select name="system.rarity" class="rarity-select">
            {{!-- v13 移除了内置的 select 块助手：助手不存在时整块被当成假值跳过，
                  下拉里一个 option 都不会渲染（表现就是"选不了也存不上"）。
                  改用本系统自己注册的 eq 助手逐个标 selected。 --}}
            <option value="common"   {{#eq system.rarity "common"}}selected{{/eq}}>平装</option>
            <option value="fine"     {{#eq system.rarity "fine"}}selected{{/eq}}>精良</option>
            <option value="epic"     {{#eq system.rarity "epic"}}selected{{/eq}}>史诗</option>
            <option value="artistic" {{#eq system.rarity "artistic"}}selected{{/eq}}>艺术</option>
            <option value="mythic"   {{#eq system.rarity "mythic"}}selected{{/eq}}>神话</option>
          </select>
        {{else}}
          <span class="rarity-display">{{rarityLabel}}</span>
        {{/if}}
      </div>
    </div>

    {{!-- ── 分割线 ──────────────────────────────────────────────────── --}}
    <div class="equip-divider"></div>

    {{!-- ── 格子（搜索栏 + 网格）────────────────────────────────────── --}}
    <div class="container-toolbar">
      <input type="text" class="container-search" placeholder="搜索容器内物品…" value="{{containerSearch}}"/>
    </div>

    <div class="cg-wrap" style="--grid-cols:{{gridCols}}; --grid-rows:{{gridRows}}">

      {{!-- 背景格（全部渲染，作拖放目标）--}}
      {{#each allCells}}
        <div class="cg-cell {{#if occupied}}cg-occupied{{/if}} {{#if locked}}cg-locked{{/if}}"
             style="grid-column:{{col}}; grid-row:{{row}}"
             data-x="{{x}}" data-y="{{y}}"
             data-locked="{{#if locked}}true{{else}}false{{/if}}">
        </div>
      {{/each}}

      {{!-- 物品图块（按 w×h 跨格）--}}
      {{#each placedItems}}
        <div class="cg-item-tile rarity-{{rarity}} {{#unless show}}cg-hidden{{/unless}}"
             style="grid-column:{{col}} / span {{w}}; grid-row:{{row}} / span {{h}}"
             data-placement-idx="{{idx}}"
             data-item-uuid="{{uuid}}"
             data-item-name="{{item.name}}"
             draggable="true"
             title="{{item.name}}">
          <img src="{{item.img}}" class="cg-tile-icon" alt="{{item.name}}">
          {{#if showQty}}<span class="cg-tile-qty">×{{item.quantity}}</span>{{/if}}
        </div>
      {{/each}}

    </div>{{!-- /cg-wrap --}}

    {{!-- ── 分割线 ──────────────────────────────────────────────────── --}}
    <div class="equip-divider"></div>

  </div>{{!-- /equip-body --}}

  {{!-- ── 固定底部按钮栏 ─────────────────────────────────────────── --}}
  <div class="item-sheet-footer">
    <div class="footer-actions">
      <button class="item-send-chat sheet-btn">发送聊天框</button>
    </div>
  </div>

</form>
